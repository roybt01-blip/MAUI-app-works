<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectCalculator.NewPage1"
             Title="NewPage1">
    <Grid> 
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="5" Background="white" Border.Stroke="White">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Label x:Name="CalculatorDisplay"
                   Text=""
                   FontSize="36"
                   TextColor="Black"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center"
                   HeightRequest="60"/>
        </Border>
        <Button Text="7" Grid.Row="1" Grid.Column="0" Clicked="Num_Clicked"></Button>
        <Button Text="8" Grid.Row="1" Grid.Column="1" Clicked="Num_Clicked"></Button>
        <Button Text="9" Grid.Row="1" Grid.Column="2" Clicked="Num_Clicked"></Button>
        <Button Text="DEL" Grid.Row="1" Grid.Column="3" Clicked="Delete_Clicked"></Button>
        <Button Text="AC" Grid.Row="1" Grid.Column="4" Clicked="Clear_All"></Button>
        <Button Text="4" Grid.Row="2" Grid.Column="0" Clicked="Num_Clicked"></Button>
        <Button Text="5" Grid.Row="2" Grid.Column="1" Clicked="Num_Clicked"></Button>
        <Button Text="6" Grid.Row="2" Grid.Column="2" Clicked="Num_Clicked"></Button>
        <Button Text="*" Grid.Row="2" Grid.Column="3" Clicked="Operation"></Button>
        <Button Text="/" Grid.Row="2" Grid.Column="4" Clicked="Operation"></Button>
        <Button Text="1" Grid.Row="3" Grid.Column="0" Clicked="Num_Clicked"></Button>
        <Button Text="2" Grid.Row="3" Grid.Column="1" Clicked="Num_Clicked"></Button>
        <Button Text="3" Grid.Row="3" Grid.Column="2" Clicked="Num_Clicked"></Button>
        <Button Text="+" Grid.Row="3" Grid.Column="3" Clicked="Operation"></Button>
        <Button Text="-" Grid.Row="3" Grid.Column="4" Clicked="Operation"></Button>
        <Button Text="0" Grid.Row="4" Grid.Column="0" Clicked="Num_Clicked"></Button>
        <Button Text="." Grid.Row="4" Grid.Column="1" Clicked="Num_Clicked"></Button>
        <Button Text="X^2" Grid.Row="4" Grid.Column="2" Clicked="Operation"></Button>
        <Button Text="Root" Grid.Row="4" Grid.Column="3" Clicked="Operation"></Button>
        <Button Text="=" Grid.Row="4" Grid.Column="4" Clicked="Calculate"></Button>


    </Grid>
</ContentPage>